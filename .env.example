# Nusxa: cp .env.example .env   — .env hech qachon git'ga tushmaydi.
# Production tartibi va har qiymat izohi: docs/DEPLOY.md

# ============ MAJBURIY (production) ============
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(50))"  (kuchsiz kalit bilan ishga tushmaydi)
SECRET_KEY=dev-insecure-change-me
DEBUG=False
# Domen(lar) — vergul bilan
# ALLOWED_HOSTS=bozor.soliq.uz
# CSRF_TRUSTED_ORIGINS=https://bozor.soliq.uz
# Xaridor QR cheki havolasi shu manzil bilan yasaladi
# PUBLIC_BASE_URL=https://bozor.soliq.uz
# Docker: PostgreSQL paroli (kuchli, kamida 20 belgi)
# DB_PASSWORD=
# Zaxira tashqi joyga (server bozorda — yong'in/o'g'irlikda baza bilan birga yo'qolmasin)
# BACKUP_UPLOAD_CMD=rclone copy {path} offsite:bozor-backup

# ============ Baza (lokal, Docker'siz) ============
# Format: postgres://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA
DATABASE_URL=postgres://bozor:bozor@127.0.0.1:5432/bozor

# ============ HTTPS / proksi ============
# docker-compose.prod.yml bularni o'zi yoqadi; boshqa usulda deploy qilsangiz — shu yerda
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False      # brauzer preload ro'yxati — qaytarib bo'lmaydigan qaror
# nginx ortida: haqiqiy IP X-Real-IP dan (aks holda hamma bitta IP — kirish blokirovkasi hammani to'sadi)
# BEHIND_PROXY=True
# Media fayllar nginx orqali, ruxsatni Django tekshiradi
# MEDIA_X_ACCEL=True

# ============ Xavfsizlik chegaralari ============
# Xodim (nazoratchi/admin/prokuror) necha daqiqa faolsizlikdan keyin chiqariladi
# STAFF_IDLE_MINUTES=60
# Bitta IP dan shuncha xato kirishdan keyin shu muddatga blok
# LOGIN_IP_MAX_FAILS=20
# LOGIN_IP_BLOCK_MINUTES=30

# ============ Celery / Redis ============
# Redis bo'lmasa (dev) — sinxron ishlaydi
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Umumiy kesh (bir necha gunicorn jarayoni uchun SHART — cheklovlar va sozlamalar keshi)
# CACHE_URL=redis://127.0.0.1:6379/2

# ============ Zaxira nusxa ============
# PG_DUMP_BIN=pg_dump
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# ============ Soliq / onlayn kassa deklaratsiyasi (bo'sh — faqat Excel import) ============
# TAX_ADAPTER=http            # yoki inbox
# TAX_API_URL=https://.../declarations
# TAX_API_TOKEN=
# TAX_API_FIELDS=stir=tin,date=date,amount=total,fiscal_id=terminal_id
# TAX_API_AMOUNT_DIVISOR=100  # summa tiyinda kelsa
# TAX_API_TIMEOUT=30
# TAX_INBOX_DIR=./tax_inbox
# TAX_SYNC_DAYS=3

# ============ Xabarlar ============
# Telegram — inspektorga qizil signal (bo'sh — yuborilmaydi)
TELEGRAM_BOT_TOKEN=
# SMS — xaridorga nasiya eslatmasi (bo'sh — o'chiq; console — faqat jurnal)
# SMS_BACKEND=eskiz           # yoki http
# SMS_ESKIZ_EMAIL=
# SMS_ESKIZ_PASSWORD=
# SMS_FROM=4546
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=

# ============ Kamera / xaridor ============
# Peshtaxta oldida kamida shuncha soniya turgan — tashrif (o'tib ketgan sanalmaydi)
# VISITOR_MIN_DWELL_SECONDS=5
# Xaridor chekdan necha kun ichida xabar yubora oladi
# RECEIPT_REPORT_DAYS=7

# ============ Monitoring ============
# Xatolar (Sentry protokoli; tavsiya — o'z serverimizdagi GlitchTip, ma'lumot chetga chiqmaydi)
# SENTRY_DSN=https://<kalit>@glitchtip.soliq.local/1
# SENTRY_ENV=production
# SENTRY_TRACES=0.05
# APP_RELEASE=2026.09.27     # qaysi versiyada xato chiqqanini bilish uchun
# APP_LOG_LEVEL=INFO
# /healthz/ batafsil javobi uchun (X-Health-Token sarlavhasi)
# HEALTH_TOKEN=
