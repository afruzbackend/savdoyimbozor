# Nusxa: cp .env.example .env
# Production'da MAJBURIY yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DEBUG=False

# --- PostgreSQL (lokal, dev) ---
# Format: postgres://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA
DATABASE_URL=postgres://bozor:bozor@127.0.0.1:5432/bozor

# --- Telegram ogohlantirish (ixtiyoriy; bo'sh bo'lsa xabar yuborilmaydi) ---
TELEGRAM_BOT_TOKEN=

# --- Celery / Redis (ixtiyoriy; Redis bo'lmasa dev sinxron ishlaydi) ---
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- Xostlar (prod) ---
# ALLOWED_HOSTS=nazorat.example.uz,sotuvchi.example.uz,panel.example.uz
# CSRF_TRUSTED_ORIGINS=https://nazorat.example.uz,https://panel.example.uz

# Zaxira nusxa
# PG_DUMP_BIN=pg_dump
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_UPLOAD_CMD=rclone copy {path} offsite:bozor-backup

# Soliq / onlayn kassa deklaratsiyasi (bo'sh — faqat Excel import)
# TAX_ADAPTER=http            # yoki inbox
# TAX_API_URL=https://.../declarations
# TAX_API_TOKEN=
# TAX_API_FIELDS=stir=tin,date=date,amount=total,fiscal_id=terminal_id
# TAX_API_AMOUNT_DIVISOR=100  # summa tiyinda kelsa
# TAX_INBOX_DIR=./tax_inbox
# TAX_SYNC_DAYS=3

# SMS — xaridorga nasiya eslatmasi (bo'sh — o'chiq; console — faqat jurnal)
# SMS_BACKEND=eskiz
# SMS_ESKIZ_EMAIL=
# SMS_ESKIZ_PASSWORD=
# SMS_FROM=4546

# Monitoring: xatolar (Sentry protokoli; tavsiya — o'z serverimizdagi GlitchTip)
# SENTRY_DSN=https://<kalit>@glitchtip.soliq.local/1
# SENTRY_ENV=production
# SENTRY_TRACES=0.05
# /healthz/ batafsil javobi uchun (X-Health-Token sarlavhasi)
# HEALTH_TOKEN=
