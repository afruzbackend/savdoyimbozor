# Nusxa: cp .env.example .env
SECRET_KEY=dev-insecure-change-me
DEBUG=True

# --- PostgreSQL (lokal, dev) ---
# Format: postgres://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA
DATABASE_URL=postgres://bozor:bozor@127.0.0.1:5432/bozor

# --- Celery / Redis (ixtiyoriy; Redis bo'lmasa dev sinxron ishlaydi) ---
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

